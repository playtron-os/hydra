FROM golang:1.26 AS builder

WORKDIR /go/src/github.com/ory/hydra

COPY oryx/go.mod oryx/go.mod
COPY oryx/go.sum oryx/go.sum
                

RUN apt-get update && apt-get upgrade -y &&\
    mkdir -p ./internal/httpclient

COPY go.mod go.sum ./
COPY internal/httpclient/go.* ./internal/httpclient/

ENV CGO_ENABLED=1

RUN go mod download

COPY . .

ARG VERSION=master
ARG COMMIT=undefined
ARG BUILD_DATE=undefined

RUN go build -tags sqlite,sqlite_omit_load_extension -o /usr/bin/hydra \
  -ldflags="-extldflags=-static -X github.com/ory/hydra/v2/driver/config.Version=${VERSION} -X github.com/ory/hydra/v2/driver/config.Commit=${COMMIT} -X github.com/ory/hydra/v2/driver/config.Date=${BUILD_DATE}"

#########################

FROM gcr.io/distroless/static-debian12:debug-nonroot AS runner

COPY --from=builder /usr/bin/hydra /usr/bin/hydra

# Declare the standard ports used by hydra (4444 for public service endpoint, 4445 for admin service endpoint)
EXPOSE 4444 4445

ENTRYPOINT ["hydra"]
CMD ["serve", "all"]
